# Example nginx config for a Kanfei public droplet (issue #336).
#
# This is a REFERENCE ONLY — copy into /etc/nginx/sites-available/,
# adjust the server_name, TLS cert paths, and the private station's
# outbound IP, then symlink into sites-enabled and reload nginx.
#
# The two-layer story:
#   - Bearer secret (app layer) — Kanfei checks every ingest push.
#   - IP allowlist (network layer) — nginx refuses ingest requests
#     from any IP other than the private station's outbound address.
# Either alone is sufficient; both together mean a stolen secret is
# useless without also being able to spoof source-IP through your
# ISP, and vice versa.
#
# Optional: add `limit_req` on the ingest paths if the droplet is
# exposed to the general internet — the bearer already refuses bad
# credentials cheaply, but a badly-behaved caller could still burn
# CPU on the connection.

server {
    listen 443 ssl http2;
    server_name droplet.example.com;

    # --- TLS ---
    ssl_certificate     /etc/letsencrypt/live/droplet.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/droplet.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # --- Public read surface: dashboard, /api/current, WS, etc. ---
    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # --- Ingest surface: locked to the private station's outbound IP ---
    #
    # Replace 203.0.113.7 with the private station's real outbound IP.
    # If the private ISP gives you a dynamic address, you'll need to
    # either use a static/business-tier IP, tunnel over a VPN with a
    # fixed egress, or omit this block and rely on the bearer only.
    location /api/ingest/ {
        allow 203.0.113.7;
        deny  all;

        # Optional per-source rate limit; adjust ``rate`` to your poll
        # interval (60 req/min covers a 1 s poll interval with plenty
        # of headroom for identity re-pushes).
        # limit_req zone=kanfei_ingest burst=10 nodelay;

        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# Optional rate-limit zone for the ingest paths.  Uncomment the
# ``limit_req_zone`` line at http{} level and the ``limit_req`` line
# in the location block above.
#
# limit_req_zone $binary_remote_addr zone=kanfei_ingest:1m rate=60r/m;

# HTTP → HTTPS redirect.
server {
    listen 80;
    server_name droplet.example.com;
    return 301 https://$host$request_uri;
}
